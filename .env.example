NODE_ENV=development
API_HOST=0.0.0.0
API_PORT=4000
PSP_SANDBOX_PORT=4100
PSP_SANDBOX_HOST=0.0.0.0
VITE_API_BASE_URL=/api/v1
DATABASE_URL=postgresql://trishul:trishul@localhost:5432/trishul
REDIS_URL=redis://localhost:6379
LOG_LEVEL=info
TRISHUL_TRUST_ACCESS_MODE=DEVELOPMENT_OPTIONAL
# JSON array of { issuerId, publicKeyPem, active? }; public keys only.
TRISHUL_TRUSTED_ISSUERS_JSON=[]
# JSON array of credential IDs to bootstrap into the selected Trust repository.
TRISHUL_REVOKED_CREDENTIAL_IDS_JSON=[]
# Required in production for bank/PSP/FI payment-risk API calls.
TRISHUL_INTERNAL_SERVICE_TOKEN=replace-with-a-long-random-service-token
EVIDENCE_ANCHOR_MODE=DEVELOPMENT_HASHCHAIN
EVIDENCE_ANCHOR_GATEWAY_URL=https://ledger-gateway.example.test/
EVIDENCE_ANCHOR_GATEWAY_TOKEN=
EVIDENCE_ANCHOR_TIMEOUT_MS=10000
EVIDENCE_ANCHOR_ALLOW_INSECURE_HTTP=false
WORKER_ID=trishul-worker-local
WORKER_POLL_MS=1000
WORKER_LEASE_MS=30000
WORKER_HEARTBEAT_MS=10000
WORKER_METRICS_MS=30000
TRISHUL_API_BASE_URL=http://127.0.0.1:4000
# Optional until the trust/access layer supplies internal service credentials.
TRISHUL_INTERNAL_SERVICE_TOKEN=
TRISHUL_API_TIMEOUT_MS=10000
