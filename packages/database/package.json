{
  "name": "@trishul/database",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "migrations",
    "seeds"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "migrate": "node dist/migrate.js",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "pg": "^8.16.3"
  },
  "devDependencies": {
    "@types/pg": "^8.15.5"
  }
}
